# ==========================================
# QUIZBATTLE - ENVIRONMENT VARIABLES (.env.example)
# Copy nội dung này sang file .env và điền giá trị thật
# ==========================================

# --- BACKEND (FASTAPI) CONFIG ---
# Chuỗi kết nối Database (PostgreSQL)
DATABASE_URL=postgresql://quizbattle:quizbattle@db:5432/quizbattle_db
# URL kết nối Redis
REDIS_URL=redis://redis:6379/0

# Cấu hình bảo mật JWT
SECRET_KEY=YOUR_SUPER_SECRET_KEY_PLEASE_CHANGE_THIS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- FRONTEND (NEXT.JS) CONFIG ---
# Trỏ về Backend API (dùng cho Docker hoặc chạy local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws